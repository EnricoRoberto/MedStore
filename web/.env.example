# Copy to .env.local and fill in with values from Firebase Console
# (Project settings > General > Your apps > Web app).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=

# API key della Gemini Developer API (https://aistudio.google.com/apikey),
# vincolata per referrer HTTP al dominio di Hosting e alla sola API
# "Generative Language" in Google Cloud Console > Credentials.
VITE_GEMINI_API_KEY=

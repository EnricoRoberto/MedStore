rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Nessuna Cloud Function e nessun custom claim: la whitelist si verifica
    // direttamente contro la collezione /allowlist (niente piano Blaze).
    function isAllowlisted() {
      return request.auth != null
        && exists(/databases/$(database)/documents/allowlist/$(request.auth.token.email))
        && get(/databases/$(database)/documents/allowlist/$(request.auth.token.email)).data.active == true;
    }

    function isValidMedication(data) {
      return data.name is string && data.name.size() > 0
        && data.producer is string
        && data.activeIngredient is string
        && data.indication is string
        && data.requiresPrescription is bool
        && data.tags is list
        && data.quantityPercent is number
        && data.quantityPercent >= 0 && data.quantityPercent <= 100
        && data.status in ['active', 'archived']
        && (data.expirationDate == null || data.expirationDate is string)
        && data.photoRefs is list
        && data.lastModifiedBy is string;
    }

    function isValidInventorySession(data) {
      return data.status in ['in_progress', 'completed'];
    }

    function isValidSessionPhoto(data) {
      return data.type in ['general', 'rotation', 'targeted']
        && data.storagePath is string;
    }

    function isValidDetectedBox(data) {
      return data.label is string
        && data.photoIds is list
        && data.status in
          ['unclassified', 'needs_more_photos', 'classified', 'confirmed', 'merged_into_existing'];
    }

    match /allowlist/{email} {
      // Ogni utente può leggere solo la propria voce (per sapere se è autorizzato
      // subito dopo il login); le scritture restano riservate alla console Firebase.
      allow read: if request.auth != null && request.auth.token.email == email;
      allow write: if false;
    }

    match /users/{uid} {
      allow read: if isAllowlisted();
      allow write: if isAllowlisted() && request.auth.uid == uid;
    }

    match /medications/{medicationId} {
      allow read: if isAllowlisted();
      allow create, update: if isAllowlisted() && isValidMedication(request.resource.data);
      allow delete: if false;

      match /changeLog/{logId} {
        allow read, create: if isAllowlisted();
        // Nessuna Cloud Function di audit: il client scrive farmaco e log
        // dello stesso cambiamento nello stesso batch (vedi lib/medications.ts).
        allow update, delete: if false;
      }
    }

    match /inventorySessions/{sessionId} {
      allow read: if isAllowlisted();
      allow create, update: if isAllowlisted() && isValidInventorySession(request.resource.data);
      allow delete: if false;

      match /photos/{photoId} {
        allow read: if isAllowlisted();
        allow create: if isAllowlisted() && isValidSessionPhoto(request.resource.data);
        allow update, delete: if false;
      }

      match /detectedBoxes/{boxId} {
        allow read: if isAllowlisted();
        allow create, update: if isAllowlisted() && isValidDetectedBox(request.resource.data);
        allow delete: if false;
      }
    }

    match /config/{doc} {
      allow read: if isAllowlisted();
      allow write: if isAllowlisted();
    }
  }
}

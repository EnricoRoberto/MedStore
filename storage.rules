rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Nessuna Cloud Function e nessun custom claim: la whitelist si verifica
    // via riferimento cross-service alla stessa collezione Firestore /allowlist.
    function isAllowlisted() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/allowlist/$(request.auth.token.email))
        && firestore.get(/databases/(default)/documents/allowlist/$(request.auth.token.email)).data.active == true;
    }

    function isValidImageUpload() {
      return request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /inventorySessions/{sessionId}/{allPaths=**} {
      allow read: if isAllowlisted();
      allow write: if isAllowlisted() && isValidImageUpload();
    }

    match /medications/{medicationId}/{allPaths=**} {
      allow read: if isAllowlisted();
      allow write: if isAllowlisted() && isValidImageUpload();
    }
  }
}
